//@version=5
indicator("Waagerechte Szenarien Pro v4.0", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================================
// EINSTELLUNGEN
// ============================================================================

group_setup = "⚙️ Haupteinstellungen"
is_enabled = input.bool(true, "Indikator Aktiviert", group=group_setup)
tf_string  = input.timeframe("3D", "Zeichnungs-Timeframe (HTF)", group=group_setup)

group_opens = "📊 Open Linien (D/W/M/Y)"
show_daily_open   = input.bool(true, "Daily Open anzeigen",   group=group_opens)
show_weekly_open  = input.bool(true, "Weekly Open anzeigen",  group=group_opens)
show_monthly_open = input.bool(true, "Monthly Open anzeigen", group=group_opens)
show_yearly_open  = input.bool(true, "Yearly Open anzeigen",  group=group_opens)
color_daily_open   = input.color(color.new(#00C851, 0), "Farbe Daily Open (grün)",    group=group_opens)
color_weekly_open  = input.color(color.new(#FF8C00, 0), "Farbe Weekly Open (orange)", group=group_opens)
color_monthly_open = input.color(color.new(#FF0000, 0), "Farbe Monthly Open (rot)",   group=group_opens)
color_yearly_open  = input.color(color.new(#2962FF, 0), "Farbe Yearly Open (blau)",   group=group_opens)

group_gva = "🎯 GVA Detection"
gva_toleranz_pct        = input.float(5.0,  "Boden/Top-Toleranz (%)",          minval=0.1, maxval=50.0,  step=0.5, group=group_gva, tooltip="Wie nah die Body-Böden/Tops der zwei Kerzen beieinander liegen dürfen. Basis wählbar (Body der 1. Kerze oder ATR). Default 5%.")
gva_kerze2_groesser_pct = input.float(40.0, "2. Kerze mindestens X% grösser",  minval=0.0, maxval=500.0, step=5.0, group=group_gva, tooltip="Body der 2. Kerze muss min. um X% grösser sein als Body der 1. Kerze. Default 40% (=1.4x).")
tol_basis               = input.string("Body 1. Kerze", "Toleranz-Basis", options=["Body 1. Kerze", "ATR (HTF)"], group=group_gva, tooltip="Body 1. Kerze: Toleranz = X% der Body-Grösse der ersten Kerze. ATR (HTF): Toleranz = X% des ATR auf dem Zeichnungs-Timeframe (wie in v3.2, aber TF-stabil).")

group_touch = "📍 Touch"
touch_wick    = input.bool(true,  "Docht (Wick) zählt als Berührung", group=group_touch)
touch_tol_atr = input.float(0.0,  "Touch-Toleranz (x ATR HTF)", minval=0.0, maxval=0.5, step=0.005, group=group_touch, tooltip="0 = exakter Punkt. Höher = Linie stoppt schon kurz vor dem Level. ATR vom Zeichnungs-TF, damit auf allen Timeframes identisch.")
atr_length    = input.int(14, "ATR Periode (HTF)", minval=1, maxval=50, group=group_touch)

group_optik = "🎨 Optik"
color_long  = input.color(color.new(#00C851, 0), "Farbe Long GVA",  group=group_optik)
color_short = input.color(color.new(#FF4444, 0), "Farbe Short GVA", group=group_optik)
line_width  = input.int(2, "Linienstärke (aktiv)", minval=1, maxval=5, group=group_optik)

// ============================================================================
// TIMEFRAME CHECKS
// ============================================================================

current_tf_in_minutes = timeframe.in_seconds() / 60
bool show_on_ltf = current_tf_in_minutes >= 15 and current_tf_in_minutes <= 240

// ============================================================================
// OPEN LINIEN (D/W/M/Y) — unverändert aus v3.2
// ============================================================================

// --- DAILY OPEN (grün, "D") ---
var line  daily_open_line  = na
var label daily_open_label = na
float daily_open_price = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)

if show_daily_open and show_on_ltf
    if na(daily_open_line) or ta.change(time("D"))
        if not na(daily_open_line)
            line.delete(daily_open_line)
            label.delete(daily_open_label)
        daily_open_line  := line.new(bar_index, daily_open_price, bar_index, daily_open_price, color=color_daily_open, width=1, style=line.style_solid, extend=extend.right)
        daily_open_label := label.new(bar_index, daily_open_price, "D", color=color.new(color.white, 100), style=label.style_none, textcolor=color.white, size=size.small)
    else
        line.set_x2(daily_open_line, bar_index)
        label.set_x(daily_open_label, bar_index + 5)

// --- WEEKLY OPEN (orange, "W") ---
var line  weekly_open_line  = na
var label weekly_open_label = na
float weekly_open_price = request.security(syminfo.tickerid, "W", open, lookahead=barmerge.lookahead_on)

if show_weekly_open and show_on_ltf
    if na(weekly_open_line) or ta.change(time("W"))
        if not na(weekly_open_line)
            line.delete(weekly_open_line)
            label.delete(weekly_open_label)
        weekly_open_line  := line.new(bar_index, weekly_open_price, bar_index, weekly_open_price, color=color_weekly_open, width=1, style=line.style_solid, extend=extend.right)
        weekly_open_label := label.new(bar_index, weekly_open_price, "W", color=color.new(color.white, 100), style=label.style_none, textcolor=color.white, size=size.small)
    else
        line.set_x2(weekly_open_line, bar_index)
        label.set_x(weekly_open_label, bar_index + 5)

// --- MONTHLY OPEN (rot, "M") ---
var line  monthly_open_line  = na
var label monthly_open_label = na
float monthly_open_price = request.security(syminfo.tickerid, "M", open, lookahead=barmerge.lookahead_on)

if show_monthly_open and show_on_ltf
    if na(monthly_open_line) or ta.change(time("M"))
        if not na(monthly_open_line)
            line.delete(monthly_open_line)
            label.delete(monthly_open_label)
        monthly_open_line  := line.new(bar_index, monthly_open_price, bar_index, monthly_open_price, color=color_monthly_open, width=1, style=line.style_solid, extend=extend.right)
        monthly_open_label := label.new(bar_index, monthly_open_price, "M", color=color.new(color.white, 100), style=label.style_none, textcolor=color.white, size=size.small)
    else
        line.set_x2(monthly_open_line, bar_index)
        label.set_x(monthly_open_label, bar_index + 5)

// --- YEARLY OPEN (blau, "Y") ---
var line  yearly_open_line  = na
var label yearly_open_label = na
float yearly_open_price = request.security(syminfo.tickerid, "12M", open, lookahead=barmerge.lookahead_on)

if show_yearly_open and show_on_ltf
    if na(yearly_open_line) or ta.change(time("12M"))
        if not na(yearly_open_line)
            line.delete(yearly_open_line)
            label.delete(yearly_open_label)
        yearly_open_line  := line.new(bar_index, yearly_open_price, bar_index, yearly_open_price, color=color_yearly_open, width=1, style=line.style_solid, extend=extend.right)
        yearly_open_label := label.new(bar_index, yearly_open_price, "Y", color=color.new(color.white, 100), style=label.style_none, textcolor=color.white, size=size.small)
    else
        line.set_x2(yearly_open_line, bar_index)
        label.set_x(yearly_open_label, bar_index + 5)

// ============================================================================
// HTF-DATEN (nur GESCHLOSSENE Kerzen -> kein Repaint, auf allen TFs identisch)
// Kerze A = vorletzte geschlossene HTF-Kerze, Kerze B = letzte geschlossene
// ============================================================================

[oA, cA, oB, cB, tB, htf_atr] = request.security(syminfo.tickerid, tf_string,
     [open[2], close[2], open[1], close[1], time[1], ta.atr(atr_length)[1]],
     lookahead=barmerge.lookahead_off)

body_A = math.abs(cA - oA)
body_B = math.abs(cB - oB)

bot_A = math.min(oA, cA)
bot_B = math.min(oB, cB)
top_A = math.max(oA, cA)
top_B = math.max(oB, cB)

// Toleranzen — beide auf HTF-Basis, damit auf jedem Chart-TF identisch
body_match_tolerance = tol_basis == "Body 1. Kerze" ? body_A * (gva_toleranz_pct / 100.0) : nz(htf_atr) * (gva_toleranz_pct / 100.0)
touch_tolerance      = nz(htf_atr) * touch_tol_atr

gva_size_factor = 1.0 + (gva_kerze2_groesser_pct / 100.0)

// ============================================================================
// DATENSTRUKTUREN (GVA-Linien)
// ============================================================================

var line[]  bull_lines  = array.new<line>()
var float[] bull_levels = array.new<float>()

var line[]  bear_lines  = array.new<line>()
var float[] bear_levels = array.new<float>()

// ============================================================================
// HAUPTLOGIK
// ============================================================================

// Touch-Quelle: Wick oder nur Body
touch_hi = touch_wick ? high : math.max(open, close)
touch_lo = touch_wick ? low  : math.min(open, close)

if is_enabled

    // ================================================================
    // GVA ERSTELLUNG — pro geschlossener HTF-Kerze genau einmal (tB wechselt)
    // ================================================================
    var int last_tB = na
    if (na(last_tB) or tB != last_tB) and body_A > 0

        first_bear  = cA < oA
        first_bull  = cA > oA
        second_bull = cB > oB
        second_bear = cB < oB
        second_larger = body_B >= body_A * gva_size_factor

        // LONG GVA (Bear -> Bull, Body-Böden nahe beieinander)
        if first_bear and second_bull and second_larger and math.abs(bot_A - bot_B) <= body_match_tolerance
            last_tB := tB
            level   = bot_B
            newLine = line.new(tB, level, time, level, xloc=xloc.bar_time, color=color_long, width=line_width, extend=extend.right, style=line.style_solid)
            array.push(bull_lines,  newLine)
            array.push(bull_levels, level)

        // SHORT GVA (Bull -> Bear, Body-Tops nahe beieinander)
        if first_bull and second_bear and second_larger and math.abs(top_A - top_B) <= body_match_tolerance
            last_tB := tB
            level   = top_B
            newLine = line.new(tB, level, time, level, xloc=xloc.bar_time, color=color_short, width=line_width, extend=extend.right, style=line.style_solid)
            array.push(bear_lines,  newLine)
            array.push(bear_levels, level)

    // ================================================================
    // LONG GVA: Touch Detection (Preis kommt von oben runter aufs Level)
    // ================================================================
    if array.size(bull_lines) > 0
        for i = array.size(bull_lines) - 1 to 0
            lvl = array.get(bull_levels, i)
            if touch_lo <= lvl + touch_tolerance
                ln = array.get(bull_lines, i)
                line.set_style(ln, line.style_dashed)
                line.set_width(ln, 1)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, time)
                array.remove(bull_lines,  i)
                array.remove(bull_levels, i)

    // ================================================================
    // SHORT GVA: Touch Detection (Preis kommt von unten hoch ans Level)
    // ================================================================
    if array.size(bear_lines) > 0
        for i = array.size(bear_lines) - 1 to 0
            lvl = array.get(bear_levels, i)
            if touch_hi >= lvl - touch_tolerance
                ln = array.get(bear_lines, i)
                line.set_style(ln, line.style_dashed)
                line.set_width(ln, 1)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, time)
                array.remove(bear_lines,  i)
                array.remove(bear_levels, i)
